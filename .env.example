# Optional CLI smoke / administrator settings. Browser users connect in Settings.
# These credentials are never a fallback for browser sessions. Never commit real keys.
AI_PROVIDER=gemini

# Optional exact public application origin behind a reverse proxy (no trailing path).
# Render uses its server-provided RENDER_EXTERNAL_URL automatically.
# APP_ORIGIN=https://your-actual-app.example.com

# Selected only when AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Selected only when AI_PROVIDER=meta; separate hackathon validation
META_API_KEY=replace_with_your_meta_api_key
META_MODEL=muse-spark-1.3

# Selected only when AI_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_API_KEY=replace_with_your_endpoint_api_key
OPENAI_COMPATIBLE_MODEL=replace_with_supported_model_id
OPENAI_COMPATIBLE_BASE_URL=https://gateway.example.com/v1
# Administrator declaration, not evidence of live compatibility
OPENAI_COMPATIBLE_STRUCTURED_OUTPUT=json_schema

# Optional server timeout settings (milliseconds), independent of connection keys.
# Each operation includes retries in one overall deadline. Generation ceiling: 150000.
AI_GENERATION_TIMEOUT_MS=90000
AI_GENERATION_DEADLINE_MS=120000
AI_DISCOVERY_TIMEOUT_MS=10000
AI_DISCOVERY_DEADLINE_MS=30000
